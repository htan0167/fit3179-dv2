{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "background": "#fffefa",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Source Sans 3, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#64736c",
      "titleColor": "#203c38",
      "gridColor": "#e8e7df",
      "domain": false,
      "tickColor": "#d6ddd7",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelLimit": 1000,
      "titleLimit": 1000,
      "orient": "bottom",
      "labelColor": "#203c38",
      "titleColor": "#203c38",
      "padding": 8
    },
    "title": {
      "fontSize": 14,
      "anchor": "start",
      "color": "#203c38"
    },
    "text": {
      "fontSize": 12,
      "color": "#203c38"
    }
  },
  "data": {
    "url": "data/workforce_growth_steps.json",
    "format": {
      "type": "json"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 64
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "2008–09",
            "Specialised",
            "Embedded",
            "Support",
            "2023–24"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Workers",
          "scale": {
            "domain": [
              0,
              660000
            ]
          },
          "axis": {
            "format": "~s"
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Total",
              "Specialised",
              "Embedded",
              "Support"
            ],
            "range": [
              "#203c38",
              "#17685f",
              "#b45841",
              "#b18736"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "step",
            "type": "nominal",
            "title": "Step"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Workers",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.next !== null"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#acb6ae",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "2008–09",
            "Specialised",
            "Embedded",
            "Support",
            "2023–24"
          ]
        },
        "x2": {
          "field": "next"
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.kind === 'Total' ? format(datum.value, ',') : '+' + format(datum.value, ',')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -11,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": [
            "2008–09",
            "Specialised",
            "Embedded",
            "Support",
            "2023–24"
          ]
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
